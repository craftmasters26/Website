# Copy to /root/web_data/.env on the VPS. NEVER commit the real file.
# RULES: every value inside double quotes; no spaces around "="; no inline comments.
# Do NOT add DATABASE_URL here (login uses MongoDB; setting it switches modes).

# Public addresses. Company site = boundless.run.place, each product = Product.boundless.run.place.
VITE_SITE_URL="https://boundless.run.place"
VITE_BLEACHDEX_URL="https://bleachdex.boundless.run.place"
# Login happens on the BleachDex site, so this is the BleachDex address.
# In the Discord Developer Portal add the redirect URI:
#   https://bleachdex.boundless.run.place/api/auth/callback/discord
BETTER_AUTH_URL="https://bleachdex.boundless.run.place"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Discord login (Discord Developer Portal > your app > OAuth2)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# MongoDB: same URI the bot uses
MONGODB_URI=""

# Bot API: the bot runs on the same VPS, so localhost
BOT_API_URL="http://127.0.0.1:5000"
# Must equal BOT_API_SECRET in /root/bot_data/.env
BOT_API_SECRET=""

# Optional: same token as the bot, lets /leaderboard show real Discord names
DISCORD_BOT_TOKEN=""
# Optional: falls back to BOT_API_SECRET if empty
AD_REWARD_SECRET=""
AD_MIN_WATCH_SECONDS="8"
