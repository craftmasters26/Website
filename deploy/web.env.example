# Copy to /root/web_data/.env on the VPS. NEVER commit the real file.
# RULES: every value inside double quotes; no spaces around "="; no inline comments.
# Do NOT add DATABASE_URL here (login uses MongoDB; setting it switches modes).

# Public addresses. Company site = boundlessproductions.org, each product = boundlessproductions.org/Product.
VITE_SITE_URL="https://boundlessproductions.org"
VITE_BLEACHDEX_URL="https://boundlessproductions.org/bleachdex"
# Login runs on the main domain now (no subdomain), so this is the bare domain, NO path.
# In the Discord Developer Portal add the redirect URI:
#   https://boundlessproductions.org/api/auth/callback/discord
BETTER_AUTH_URL="https://boundlessproductions.org"
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Discord login (Discord Developer Portal > your app > OAuth2)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# MongoDB: same URI the bot uses
MONGODB_URI=""

# Bot API: the bot runs on the same VPS, so localhost
BOT_API_URL="http://127.0.0.1:5000"
# Must equal BOT_API_SECRET in /root/bot_data/.env
BOT_API_SECRET=""

# Optional: same token as the bot, lets /leaderboard show real Discord names
DISCORD_BOT_TOKEN=""
# Optional: falls back to BOT_API_SECRET if empty
AD_REWARD_SECRET=""
AD_MIN_WATCH_SECONDS="8"

# Contact page form: a Discord channel webhook (Server Settings > Integrations > Webhooks).
# Without it the form returns a friendly "use Discord" message.
CONTACT_WEBHOOK_URL=
# Optional public contact address shown on the Contact page (build-time).
VITE_CONTACT_EMAIL=

# Browser error alerts go to this Discord webhook (falls back to CONTACT_WEBHOOK_URL if empty).
ERROR_WEBHOOK_URL=
# Optional analytics (Umami, free cloud or self-hosted). Build-time: set both, then rebuild.
VITE_UMAMI_SRC=https://cloud.umami.is/script.js
VITE_UMAMI_ID=
